# Dependencies
node_modules/
.pnpm-store/
.npm/

# Output/Download folders
download-output/
outputs/

# Next.js
frontend/.next/
# The deploy builds into .next-build and parks the outgoing build in
# .next-previous so a failed deploy has something to put back.
frontend/.next-build/
frontend/.next-previous/
frontend/out/
frontend/.pnpm-store/

# .NET / Build outputs
backend/bin/
backend/obj/
*.user

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.development
frontend/.env.local
frontend/.env.production
backend/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets & server-only configs — never commit (public repo)
backend/appsettings.json
backend/appsettings.Production.json

# ...and every copy of them. A backup made before editing the live config holds
# the same live keys, and a name like appsettings.json.before-jwt-rotation does
# not match the two lines above - which is exactly how one of them reached a
# commit. Anything that starts with appsettings. and is not the example file is
# treated as the real thing.
backend/appsettings.*
!backend/appsettings.example.json
backend/out/
import_products.py

# Admin-uploaded product images — these live on the VPS, not in git.
# (The 27 images already committed stay tracked; only new uploads are ignored.)
frontend/public/product-images/

# Stray clones / scratch repos accidentally created inside the project
/Mahalaxmi-Fashion/
/mahalaxmi-nextjs/

# TypeScript's incremental build cache. It is rewritten by every typecheck, so
# tracking it makes a changed file appear after every build.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
.next-seocheck/

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json
