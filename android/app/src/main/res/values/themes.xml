<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Mahalaxmi" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/page_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Shown for the split second before the site paints, so there is no white flash. -->
    <style name="Theme.Mahalaxmi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Mahalaxmi</item>
    </style>

</resources>
