# Copy this file to keystore.properties and fill in the real values.
# keystore.properties is git-ignored on purpose - never commit the keystore or its passwords.
#
# Keep signing.keystore inside this android folder and use the relative path below.
# An absolute Windows path also works, but a path with spaces or a different drive
# letter tends to fail, so the local copy is the safe option.
storeFile=../signing.keystore
storePassword=PUT_THE_KEYSTORE_PASSWORD_HERE
keyAlias=my-key-alias
keyPassword=PUT_THE_KEY_PASSWORD_HERE
